# Copy these keys to Streamlit Community Cloud > App settings > Secrets.
# Replace every placeholder. Do not commit real credentials.

# HTTPS URL for the OpenCode HTTP API or its protected gateway.
OPENCODE_BASE_URL = "https://opencode.example.com"

# For the native OpenCode v2 server, this is the password configured with
# OPENCODE_PASSWORD on the OpenCode host. Use a gateway token if using Bearer.
OPENCODE_API_TOKEN = "replace-with-a-long-secret"

# Must be an absolute path on the machine running OpenCode, not Streamlit Cloud.
OPENCODE_WORKSPACE = "/srv/book-ingenieria"

# Use "basic" for native OpenCode v2 auth, or "bearer" for a Bearer-aware gateway.
OPENCODE_AUTH_SCHEME = "basic"
OPENCODE_USERNAME = "opencode"
